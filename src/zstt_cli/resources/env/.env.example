# Copy required test values to .env.local. Never commit the populated file.
ZSTT_ENV=test

# Alibaba Cloud Observability
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=cn-hangzhou

# Alibaba Cloud client app logs (separate test credential)
ZSTT_CLIENT_ALIBABA_CLOUD_ACCESS_KEY_ID=
ZSTT_CLIENT_ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ZSTT_CLIENT_ALIBABA_CLOUD_REGION=cn-hangzhou

# Alibaba Cloud DMS MCP (separate database credential)
# The dms scope maps these values to ALIBABA_CLOUD_* for the child process.
ZSTT_DMS_ALIBABA_CLOUD_ACCESS_KEY_ID=
ZSTT_DMS_ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ZSTT_DMS_ALIBABA_CLOUD_SECURITY_TOKEN=

# Elasticsearch read-only diagnosis account
ZSTT_ES_HOST=
ZSTT_ES_PORT=9200
ZSTT_ES_URL=
ZSTT_ES_USERNAME=
ZSTT_ES_PASSWORD=
ZSTT_ES_INDEX_PREFIX=
