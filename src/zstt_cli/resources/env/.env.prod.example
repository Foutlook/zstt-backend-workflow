# Copy required production values to .env.prod.local. Never commit the populated file.
ZSTT_ENV=prod

# Alibaba Cloud Observability
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION=cn-hangzhou

# MySQL read-only diagnosis account
ZSTT_MYSQL_HOST=
ZSTT_MYSQL_PORT=3306
ZSTT_MYSQL_URL=
ZSTT_MYSQL_USERNAME=
ZSTT_MYSQL_PASSWORD=
ZSTT_MYSQL_DATABASE=
ZSTT_MYSQL_DRIVER=com.mysql.cj.jdbc.Driver

# Elasticsearch read-only diagnosis account
ZSTT_ES_HOST=
ZSTT_ES_PORT=9200
ZSTT_ES_URL=
ZSTT_ES_USERNAME=
ZSTT_ES_PASSWORD=
ZSTT_ES_INDEX_PREFIX=
